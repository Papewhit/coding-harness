{
  "schema_version": "pico-eval-control-overlay-v1",
  "wave": "W4",
  "purpose": "readable canonical integration history",
  "overlay_parent_sha": "ba7341cde7fe017edb9a42bc196f85aa1d3b8d90",
  "upstream_canonical_sha": "85bd1eece7da388c4af2c5a622f0dc5a74fc051f",
  "upstream_handoff": {
    "path": ".codex/eval/state/W3-wave-handoff.json",
    "sha256": "2ce386f998b774cbb9fa2bb8cef9f84ebd0f5854a6af4a11e01d252f7675d37b"
  },
  "upstream_status_sha256": "eb49e1ee3ce8836ffd6f63486479b5433245aab2c4c5dee9efcf5c58f046a946",
  "upstream_freeze_sha256": "0e985d4a46479c34f4bf4567191f487e5f3e530671129b6974c86316e03a400f",
  "rules": {
    "normalized_ticket_commit": {
      "maximum_per_ticket_with_source_or_fixture_changes": 1,
      "subject_must_contain_ticket_id": true,
      "merge_method": "git cherry-pick --no-commit for every worker-owned commit, followed by one canonical commit",
      "required_commit_body_fields": [
        "worker_head",
        "worker_commits",
        "dependency_commits",
        "handoff_sha256",
        "tests",
        "stable_patch_id_verification"
      ],
      "stable_patch_id_command": "git diff <wave-base>..<worker-head> | git patch-id --stable"
    },
    "control_commits": {
      "forbid_per_ticket_dispatch_commits": true,
      "forbid_per_ticket_accept_commits": true,
      "allowed_kinds": [
        "wave_open",
        "batch_checkpoint",
        "wave_close",
        "wave_handoff"
      ]
    },
    "commit_map": {
      "path": ".codex/eval/state/W4-commit-map.json",
      "must_map_every_worker_commit_to_canonical_commit": true
    },
    "worker_bundle": {
      "required_at_wave_close": true,
      "artifact_path": "F:\\dev\\llm\\pico-eval-artifacts\\wave-bundles\\W4-workers.bundle",
      "verification_command": "git bundle verify <bundle>",
      "record_sha256": true
    },
    "cleanup": {
      "delete_worker_branches_or_worktrees_without_user_approval": false,
      "report_cleanup_candidates_only": true
    },
    "canonical_tag": {
      "name": "eval-v3/w4-canonical",
      "annotated": true,
      "must_verify_target": true
    }
  }
}
