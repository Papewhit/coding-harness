{
  "schema_version": "pico-eval-control-overlay-v1",
  "wave": "W2",
  "purpose": "readable canonical integration history",
  "overlay_parent_sha": "c5c4d54e6edf06a69f30c4d95c7aac0a08633625",
  "upstream_canonical_sha": "67d5f8bf10a65c39885f203e7edb7aede7beb27b",
  "upstream_handoff": {
    "path": ".codex/eval/state/W1-wave-handoff.json",
    "sha256": "03923c4316e603bb1ffe2ac16f2fcb47a8741e638267220b03781669103e114f"
  },
  "upstream_status_sha256": "fd0095b76f392f27806aac5a4d8481c9bc24369864dd52f4c824039634a674b9",
  "upstream_freeze_sha256": "271b0078e42b72d2295ac20ecc33e1fe8f993a1b47e66fe7b4104a9d4d60a075",
  "rules": {
    "normalized_ticket_commit": {
      "maximum_per_ticket_with_source_or_fixture_changes": 1,
      "subject_must_contain_ticket_id": true,
      "merge_method": "git cherry-pick --no-commit for every worker-owned commit, followed by one canonical commit",
      "required_commit_body_fields": [
        "worker_head",
        "worker_commits",
        "dependency_commits",
        "handoff_sha256",
        "tests",
        "stable_patch_id_verification"
      ],
      "stable_patch_id_command": "git diff <wave-base>..<worker-head> | git patch-id --stable"
    },
    "control_commits": {
      "forbid_per_ticket_dispatch_commits": true,
      "forbid_per_ticket_accept_commits": true,
      "allowed_kinds": [
        "wave_open",
        "batch_checkpoint",
        "wave_close",
        "wave_handoff"
      ]
    },
    "commit_map": {
      "path": ".codex/eval/state/W2-commit-map.json",
      "must_map_every_worker_commit_to_canonical_commit": true
    },
    "worker_bundle": {
      "required_at_wave_close": true,
      "artifact_path": "F:\\dev\\llm\\pico-eval-artifacts\\wave-bundles\\W2-workers.bundle",
      "verification_command": "git bundle verify <bundle>",
      "record_sha256": true
    },
    "cleanup": {
      "delete_worker_branches_or_worktrees_without_user_approval": false,
      "report_cleanup_candidates_only": true
    },
    "canonical_tag": {
      "name": "eval-v3/w2-canonical",
      "annotated": true,
      "must_verify_target": true
    }
  }
}
