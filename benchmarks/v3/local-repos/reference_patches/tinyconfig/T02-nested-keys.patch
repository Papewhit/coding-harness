+def _read_value(values: Mapping[str, object], key: str, default: str) -> str:
+    if key in values:
+        return str(values[key])
+    section, _, field = key.partition("_")
+    nested_name = {"APP": "app", "DATABASE": "database"}.get(section)
+    if not nested_name:
+        return default
+    nested = values.get(nested_name, {})
+    if not isinstance(nested, Mapping):
+        raise ConfigError(f"{nested_name} must be a mapping")
+    nested_key = {"DEBUG": "debug", "HOST": "host", "PORT": "port"}.get(field)
+    if nested_key and nested_key in nested:
+        return str(nested[nested_key])
+    return default
