{
  "schema_version": "pico-local-repo-taskset-v1",
  "taskset_id": "pico-local-python-v1",
  "version": 1,
  "language": "python",
  "execution_policy": {
    "network_access": false,
    "workspace_source": "disposable_copy_of_base_snapshot",
    "workspace_visible_content": [
      "base_snapshot"
    ],
    "workspace_excluded_content": [
      "task_doc",
      "hidden_verifier",
      "reference_patch"
    ],
    "path_root": "benchmarks/v3/local-repos"
  },
  "repositories": [
    {
      "id": "tinyconfig",
