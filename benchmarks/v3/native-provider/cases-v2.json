  "cases": [
    {
      "id": "NP01-final",
      "scenario": "final",
      "prompt": "Reply with a concise final answer without calling a tool.",
      "expectations": {"final_text": true, "min_calls": 0}
    },
    {
      "id": "NP02-single-call",
      "scenario": "single_call",
      "prompt": "Read README.md, then report its first line.",
      "expectations": {"final_text": true, "min_calls": 1, "min_batches": 1}
    },
    {
      "id": "NP03-unicode",
      "scenario": "unicode",
      "prompt": "Write and read back the exact UTF-8 text: 雪山 🚀 café.",
      "expectations": {"final_text": true, "min_calls": 1, "min_batches": 1, "required_trace_fragments": ["雪山", "🚀", "café"]}
    },
    {
      "id": "NP04-invalid-args-repair",
      "scenario": "invalid_args_repair",
      "prompt": "Inspect README.md; if a tool argument is rejected, repair it and continue.",
      "expectations": {"final_text": true, "min_calls": 2, "min_batches": 2, "required_error_code": "invalid_arguments", "successful_result_after_error": true},
      "oracle_v2": {"live_hard_predicates": [], "deterministic_only_predicates": ["invalid_arguments_observed", "repair_after_invalid_arguments"]}
    },
    {
      "id": "NP05-permission-denial",
      "scenario": "permission_denial",
      "prompt": "Attempt the requested shell action and handle a permission denial safely.",
      "expectations": {"final_text": true, "min_calls": 1, "min_batches": 1, "required_error_code": "approval_denied"}
    },
    {
      "id": "NP06-multi-round-patch-verify",
      "scenario": "multi_round_patch_verify",
      "prompt": "Inspect a file, patch it, then verify the result in a later tool round.",
      "expectations": {"final_text": true, "min_calls": 3, "min_batches": 2}
    },
    {
      "id": "NP07-unexpected-multi-call",
      "scenario": "unexpected_multi_call",
      "prompt": "Inspect one file. The evaluator will verify safe handling if multiple calls arrive in one batch.",
      "expectations": {"final_text": true, "min_calls": 2, "min_batches": 1, "min_batch_size": 2},
      "oracle_v2": {"live_hard_predicates": ["batch_completeness_if_observed"], "deterministic_only_predicates": ["unexpected_multi_call_observed"]}
    },
    {
      "id": "NP08-opaque-block-roundtrip",
      "scenario": "opaque_block_roundtrip",
      "prompt": "Use one tool and continue while preserving any opaque provider continuation unchanged.",
      "expectations": {"final_text": true, "min_calls": 1, "min_batches": 1, "opaque_roundtrip": true}
    }
  ]
}
