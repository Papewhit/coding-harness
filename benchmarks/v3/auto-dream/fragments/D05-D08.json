    {
      "id": "D05",
      "description": "Multi-topic index preserves stable user facts while replacing an Atlas location without retaining a transient complaint.",
      "fixture": {"memory": "fixtures/D05/memory", "sessions": "fixtures/D05/sessions"},
      "oracle": {
        "facts": [
          {"id": "concise-chinese-updates", "disposition": "must_keep", "anchors": ["concise Chinese status updates"], "topics": ["topics/user-collaboration.md"]},
          {"id": "atlas-release-notes-location", "disposition": "replace", "anchors": ["docs/release-notes/"], "old_anchors": ["docs/releases/"], "topics": ["topics/atlas-project.md"]},
          {"id": "transient-preview-frustration", "disposition": "drop", "anchors": ["flaky preview"]}
        ],
        "topics": [
          {"path": "topics/user-collaboration.md", "facts": ["concise-chinese-updates"]},
          {"path": "topics/atlas-project.md", "facts": ["atlas-release-notes-location"]}
        ],
        "index": {"path": "MEMORY.md", "must_link": ["topics/user-collaboration.md", "topics/atlas-project.md"], "max_lines": 12},
        "frontmatter": {"required": ["name", "description", "type"], "allowed_types": ["user", "project"]},
        "allowed_write_scope": ".pico/memory",
        "snapshot": {"ignore_frontmatter_fields": ["updated_at", "last_dream_at"]}
      }
    },
